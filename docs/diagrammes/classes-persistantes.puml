@startuml GMAO_Classes_Persistantes
title GMAO Polyclinique - Classes persistantes
left to right direction
hide methods
hide circle
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false

abstract class BaseEntity <<MappedSuperclass>> {
  +id : UUID <<PK>>
  +version : long <<Version>>
  +createdAt : Instant
  +updatedAt : Instant
  +createdBy : UUID <<FK>>
  +archived : boolean
}

package "Comptes et persistance technique" {
  class "AuthSession\n(auth_session)" as AuthSession <<Entity>> {
    +id : UUID <<PK>>
    +userId : UUID <<FK>>
    +refreshHash : String
    +expiresAt : Instant
    +revoked : boolean
  }
  class "UserAccount\n(app_user)" as UserAccount <<Entity>> {
    +id : UUID <<PK>>
    +email : String
    +name : String
    +passwordHash : String
    +role : String
    +active : boolean
    +contractorId : UUID <<FK>>
    +version : long <<Version>>
    +createdAt : Instant
  }
  class "ResetToken\n(reset_token)" as ResetToken <<SQL>> {
    +id : UUID <<PK>>
    +userId : UUID <<FK>>
    +hash : String
    +expiresAt : Instant
    +used : boolean
  }
  class "CommandReceipt\n(command_receipt)" as CommandReceipt <<SQL>> {
    +id : UUID <<PK>>
    +userId : UUID <<FK>>
    +operationKey : UUID
    +requestHash : String
    +response : JsonNode <<JSONB>>
    +createdAt : Instant
  }
}

package "Patrimoine" {
  class "Asset\n(asset)" as Asset <<Entity>> {
