  }
  class "Attachment\n(attachment)" as Attachment <<Entity>> {
    +targetType : String
    +targetId : UUID
    +name : String
    +objectKey : String
    +contentType : String
    +size : Long
  }
  class "Location\n(location)" as Location <<Entity>> {
    +code : String
    +name : String
    +type : String
    +parentId : UUID <<FK>>
  }
}

